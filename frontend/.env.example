# =============================================================================
# Frontend environment variables (copy to .env and fill in for deployment)
# cp .env.example .env
# =============================================================================

# API base URL
# Development (Vite dev server proxies /api to localhost:5000 — can leave empty):
# VITE_API_URL=
#
# Production (point to your deployed backend):
# VITE_API_URL=https://api.yourdomain.com/api
#
# Same-origin deploy (frontend + API behind one domain with /api reverse proxy):
VITE_API_URL=/api
